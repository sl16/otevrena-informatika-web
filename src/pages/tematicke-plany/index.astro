---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IconRenderer from '../../components/IconRenderer.astro';
import { getPresentations } from '../../lib/content';
import type { CurriculumCategory } from '../../lib/curriculumCategories';
import { ogImageUrl } from '../../lib/seo';

const presentations = await getPresentations();
const studentPresentations = presentations.filter(
  (presentation) => presentation.id !== 'pedagogicke-skoleni-ai-pro-asistenty',
);
const categoryOrder: CurriculumCategory[] = [
  'Umělá inteligence',
  'Internet',
  'Mediální gramotnost',
  'Algoritmizace a programování',
  'Kancelářský balík',
  'Digitální technologie',
  'Jiné',
  'Kyberbezpečnost',
  'Informace a data',
  'Počítače a operační systémy',
];
const categoryIcons: Record<CurriculumCategory, string> = {
  'Umělá inteligence': 'brain',
  'Mediální gramotnost': 'newspaper',
  Kyberbezpečnost: 'shield-lock',
  'Kancelářský balík': 'layout',
  'Informace a data': 'database',
  'Algoritmizace a programování': 'terminal',
  'Digitální technologie': 'smartphone',
  'Počítače a operační systémy': 'cpu',
  Internet: 'globe',
  Jiné: 'more-horizontal',
};

const categoriesInUse = new Set(studentPresentations.map((presentation) => presentation.category));
const blocks = categoryOrder
  .filter((category) => categoriesInUse.has(category))
  .map((category) => ({
    title: category,
    iconName: categoryIcons[category],
    presentations: studentPresentations.filter((presentation) => presentation.category === category),
  }));
---

<BaseLayout
  title="Tematický plán | Otevřená informatika"
  description="Návrh tematického plánu pro výuku informatiky na SŠ."
  image={ogImageUrl({ type: 'home' })}
>
  <main class="min-h-screen">
    <section class="py-16">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <h1 class="text-4xl md:text-5xl font-black text-white tracking-tighter">Tematický plán</h1>
          <p class="text-slate-400 mt-4 leading-relaxed">
            Doporučené rozložení témat a navazující prezentace pro střední školy.
          </p>
        </div>

        <div class="mt-12 relative pl-8 before:absolute before:left-0 before:top-0 before:bottom-0 before:w-px before:bg-white/10 space-y-12">
          {blocks.map((block) => (
            <div class="relative">
              <div class="absolute left-[-2.5rem] w-8 h-8 flex items-center justify-center rounded-full bg-brand-card border border-brand-neon/30">
                <IconRenderer name={block.iconName} size={16} className="text-brand-neon" />
              </div>
              <div class="mb-6">
                <h2 class="text-2xl font-black text-white">{block.title}</h2>
              </div>

              <div class="grid grid-cols-1 gap-4">
                {block.presentations.map((presentation) => (
                  <a
                    href={`/prezentace/${presentation.id}/index.html`}
                    class="rounded-2xl border p-5 ml-2 bg-brand-card/40 border-white/10 hover:border-brand-cyan/40"
                  >
                    <p class="font-bold text-white hover:text-brand-cyan transition-colors">{presentation.title}</p>
                    <p class="text-sm text-slate-400 mt-1">{presentation.description}</p>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>