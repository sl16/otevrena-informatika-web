---
interface Props {
  href: string;
  title: string;
  description: string;
  category: string;
  date?: Date;
}

const { href, title, description, category, date } = Astro.props;
const formattedDate = date
  ? new Intl.DateTimeFormat('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' }).format(date)
  : undefined;
---

<article
  class="presentation-card bg-brand-card/50 backdrop-blur-sm rounded-3xl border border-white/5 overflow-hidden hover:border-brand-neon/30 hover:bg-brand-card transition-all duration-500 group flex flex-col shadow-2xl"
  data-category={category}
  data-search={`${title} ${description} ${category}`.toLocaleLowerCase('cs')}
>
  <a href={href} aria-label={`Otevřít prezentaci: ${title}`} class="flex flex-col h-full">
    <div class="p-6 flex flex-col flex-grow">
      <div class="mb-4 flex justify-between items-center">
        <span class="text-[10px] font-mono font-bold uppercase tracking-[0.2em] text-brand-neon">
          {category}
        </span>
        {formattedDate && <time datetime={date?.toISOString()} class="text-xs text-slate-500">{formattedDate}</time>}
      </div>

      <h2 class="text-xl font-black text-white group-hover:text-brand-cyan transition-colors mb-3 leading-tight">
        {title}
      </h2>
      <p class="text-slate-400 text-sm leading-relaxed">{description}</p>

      <div class="mt-auto flex items-center justify-between pt-6">
        <span class="text-xs font-mono font-bold text-slate-400 group-hover:text-brand-neon transition-colors">
          Otevřít prezentaci
        </span>
        <span
          aria-hidden="true"
          class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center text-slate-400 group-hover:bg-brand-neon group-hover:text-brand-dark transition-all duration-300"
        >
          ↗
        </span>
      </div>
    </div>
  </a>
</article>
