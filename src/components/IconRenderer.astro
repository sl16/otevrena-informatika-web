---
interface Props {
  name?: string;
  size?: number;
  className?: string;
}

const { name, size = 24, className = '' } = Astro.props;

const getIcon = () => {
  switch (name) {
    case 'terminal':
      return '💻';
    case 'brain':
      return '🧠';
    case 'cpu':
      return '⚙️';
    case 'shield-lock':
      return '🔒';
    case 'mail-warning':
      return '⚠️';
    case 'mail':
      return '📨';
    case 'circuit-board':
      return '🔌';
    case 'binary':
      return '🔢';
    case 'code':
      return '⌨️';
    case 'zap':
      return '⚡';
    case 'book':
      return '📖';
    case 'database':
      return '🗄️';
    case 'newspaper':
      return '📰';
    case 'smartphone':
      return '📱';
    case 'layout':
      return '🎨';
    case 'more-horizontal':
      return '💬';
    case 'map':
      return '🗺️';
    case 'footprint':
      return '👣';
    case 'television':
      return '📺';
	case 'presentation':
      return '💬';
    default:
      return '📄';
  }
};

---

<div
  class={`flex items-center justify-center rounded-3xl transition-all duration-500 bg-white/5 text-slate-400 ${className}`}
  style={`font-size: ${size}px;`}
>
  {getIcon()}
</div>
